import { useState, useEffect } from 'react'
import { motion } from 'framer-motion'
import { 
  RefreshCw, Calendar, Package, Pause, Play, X, 
  MapPin, Edit, TrendingDown, Clock, CheckCircle 
} from 'lucide-react'
import { useNavigate } from 'react-router-dom'
import API from '../../api/axiosConfig'
import toast from 'react-hot-toast'
import AdvancedSEO from '../../components/seo/AdvancedSEO'

function MySubscriptions() {
  const navigate = useNavigate()
  const [subscriptions, setSubscriptions] = useState([])
  const [loading, setLoading] = useState(true)
  const [filter, setFilter] = useState('all')

  useEffect(() => {
    fetchSubscriptions()
  }, [filter])

  const fetchSubscriptions = async () => {
    try {
      setLoading(true)
      const params = filter !== 'all' ? `?status=${filter}` : ''
      const response = await API.get(`/subscriptions/my-subscriptions${params}`)
      setSubscriptions(response.data.subscriptions)
    } catch (error) {
      toast.error('Abonelikler yüklenemedi')
    } finally {
      setLoading(false)
    }
  }

  const handlePause = async (id) => {
    try {
      await API.post(`/subscriptions/${id}/pause`)
      toast.success('Abonelik duraklatıldı')
      fetchSubscriptions()
    } catch (error) {
      toast.error(error.response?.data?.message || 'İşlem başarısız')
    }
  }

  const handleResume = async (id) => {
    try {
      await API.post(`/subscriptions/${id}/resume`)
      toast.success('Abonelik devam ettirildi')
      fetchSubscriptions()
    } catch (error) {
      toast.error(error.response?.data?.message || 'İşlem başarısız')
    }
  }

  const handleCancel = async (id) => {
    if (!confirm('Aboneliği iptal etmek istediğinizden emin misiniz?')) {
      return
    }

    try {
      await API.post(`/subscriptions/${id}/cancel`, {
        reason: 'Kullanıcı talebi'
      })
      toast.success('Abonelik iptal edildi')
      fetchSubscriptions()
    } catch (error) {
      toast.error(error.response?.data?.message || 'İşlem başarısız')
    }
  }

  const statusConfig = {
    active: {
      color: 'bg-green-500',
      text: 'Aktif',
      icon: CheckCircle
    },
    paused: {
      color: 'bg-yellow-500',
      text: 'Duraklatıldı',
      icon: Pause
    },
    cancelled: {
      color: 'bg-red-500',
      text: 'İptal Edildi',
      icon: X
    },
    expired: {
      color: 'bg-gray-500',
      text: 'Süresi Doldu',
      icon: Clock
    }
  }

  const planNames = {
    weekly: 'Haftalık',
    biweekly: 'İki Haftalık',
    monthly: 'Aylık',
    quarterly: 'Üç Aylık'
  }

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 dark:bg-dark-bg flex items-center justify-center">
        <div className="animate-spin w-12 h-12 border-4 border-blue-600 border-t-transparent rounded-full"></div>
      </div>
    )
  }

  return (
    <>
      <AdvancedSEO
        title="Aboneliklerim - MyShop"
        description="Aktif aboneliklerinizi yönetin, duraklatın veya iptal edin. Düzenli teslimatlarınızı takip edin."
        keywords="abonelik, düzenli teslimat, otomatik sipariş"
      />

      <div className="min-h-screen bg-gray-50 dark:bg-dark-bg py-12">
        <div className="max-w-6xl mx-auto px-4">
          {/* Header */}
          <div className="flex items-center justify-between mb-8">
            <div className="flex items-center gap-3">
              <div className="w-16 h-16 bg-gradient-to-r from-blue-600 to-cyan-600 rounded-2xl flex items-center justify-center">
                <RefreshCw size={32} className="text-white" />
              </div>
              <div>
                <h1 className="text-3xl font-bold dark:text-dark-text">Aboneliklerim</h1>
                <p className="text-gray-600 dark:text-gray-400">
                  {subscriptions.length} abonelik
                </p>
              </div>
            </div>

            <button
              onClick={() => navigate('/products')}
              className="px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-xl font-bold hover:shadow-xl transition"
            >
              Yeni Abonelik
            </button>
          </div>

          {/* Filters */}
          <div className="flex gap-3 mb-6 overflow-x-auto">
            {[
              { id: 'all', label: 'Tümü' },
              { id: 'active', label: 'Aktif' },
              { id: 'paused', label: 'Duraklatıldı' },
              { id: 'cancelled', label: 'İptal Edildi' }
            ].map((f) => (
              <button
                key={f.id}
                onClick={() => setFilter(f.id)}
                className={`px-4 py-2 rounded-lg font-semibold whitespace-nowrap transition ${
                  filter === f.id
                    ? 'bg-gradient-to-r from-blue-600 to-cyan-600 text-white'
                    : 'bg-gray-200 dark:bg-dark-hover hover:bg-gray-300 dark:hover:bg-dark-border dark:text-dark-text'
                }`}
              >
                {f.label}
              </button>
            ))}
          </div>

          {/* Subscriptions List */}
          {subscriptions.length === 0 ? (
            <div className="text-center py-12">
              <RefreshCw size={64} className="mx-auto mb-4 text-gray-400" />
              <h3 className="text-xl font-bold mb-2 dark:text-dark-text">
                {filter === 'all' ? 'Henüz Aboneliğiniz Yok' : `${filter.charAt(0).toUpperCase() + filter.slice(1)} Abonelik Bulunamadı`}
              </h3>
              <p className="text-gray-600 dark:text-gray-400 mb-6">
                Düzenli teslimat ile tasarruf edin!
              </p>
              <button
                onClick={() => navigate('/products')}
                className="px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-xl font-bold hover:shadow-xl transition"
              >
                Ürünlere Göz At
              </button>
            </div>
          ) : (
            <div className="space-y-6">
              {subscriptions.map((subscription) => {
                const status = statusConfig[subscription.status]
                const StatusIcon = status.icon
                const nextDelivery = new Date(subscription.nextDeliveryDate)
                const daysUntilDelivery = Math.ceil((nextDelivery - new Date()) / (1000 * 60 * 60 * 24))

                return (
                  <motion.div
                    key={subscription._id}
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    className="bg-white dark:bg-dark-card rounded-2xl shadow-xl overflow-hidden"
                  >
                    {/* Status Bar */}
                    <div className={`${status.color} p-3 flex items-center justify-between text-white`}>
                      <div className="flex items-center gap-2">
                        <StatusIcon size={20} />
                        <span className="font-bold">{status.text}</span>
                      </div>
                      <span className="text-sm">#{subscription.subscriptionNumber}</span>
                    </div>

                    <div className="p-6">
                      <div className="flex flex-col md:flex-row gap-6">
                        {/* Product Image */}
                        <img
                          src={subscription.product.images[0]}
                          alt={subscription.product.name}
                          className="w-full md:w-40 h-40 object-cover rounded-xl"
                        />

                        {/* Details */}
                        <div className="flex-1">
                          <h3 className="text-xl font-bold mb-2 dark:text-dark-text">
                            {subscription.product.name}
                          </h3>

                          {/* Info Grid */}
                          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                            <div>
                              <p className="text-sm text-gray-600 dark:text-gray-400">Plan</p>
                              <p className="font-bold dark:text-dark-text">
                                {planNames[subscription.plan]}
                              </p>
                            </div>
                            <div>
                              <p className="text-sm text-gray-600 dark:text-gray-400">Adet</p>
                              <p className="font-bold dark:text-dark-text">
                                {subscription.quantity}
                              </p>
                            </div>
                            <div>
                              <p className="text-sm text-gray-600 dark:text-gray-400">Fiyat</p>
                              <p className="font-bold text-blue-600">
                                {subscription.finalPrice.toFixed(2)}₺
                              </p>
                            </div>
                            <div>
                              <p className="text-sm text-gray-600 dark:text-gray-400">Tasarruf</p>
                              <p className="font-bold text-green-600">
                                %{subscription.discount}
                              </p>
                            </div>
                          </div>

                          {/* Next Delivery */}
                          {subscription.status === 'active' && (
                            <div className="flex items-center gap-2 mb-4 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-900">
                              <Calendar className="text-blue-600" size={20} />
                              <div>
                                <p className="text-sm text-gray-600 dark:text-gray-400">
                                  Sonraki Teslimat
                                </p>
                                <p className="font-bold dark:text-dark-text">
                                  {nextDelivery.toLocaleDateString('tr-TR', {
                                    day: 'numeric',
                                    month: 'long',
                                    year: 'numeric'
                                  })}
                                  <span className="text-sm text-blue-600 ml-2">
                                    ({daysUntilDelivery} gün kaldı)
                                  </span>
                                </p>
                              </div>
                            </div>
                          )}

                          {/* Stats */}
                          <div className="flex items-center gap-4 mb-4 text-sm text-gray-600 dark:text-gray-400">
                            <div className="flex items-center gap-1">
                              <Package size={16} />
                              <span>{subscription.totalDeliveries} teslimat yapıldı</span>
                            </div>
                            <div className="flex items-center gap-1">
                              <TrendingDown size={16} />
                              <span>
                                {((subscription.price - subscription.finalPrice) * subscription.totalDeliveries).toFixed(2)}₺ tasarruf
                              </span>
                            </div>
                          </div>

                          {/* Address */}
                          <div className="p-3 bg-gray-50 dark:bg-dark-hover rounded-lg mb-4">
                            <div className="flex items-start gap-2">
                              <MapPin size={16} className="text-gray-600 dark:text-gray-400 mt-1" />
                              <div className="flex-1">
                                <p className="text-sm font-semibold dark:text-dark-text">
                                  {subscription.shippingAddress.fullName}
                                </p>
                                <p className="text-sm text-gray-600 dark:text-gray-400">
                                  {subscription.shippingAddress.address}
                                </p>
                                <p className="text-sm text-gray-600 dark:text-gray-400">
                                  {subscription.shippingAddress.district} / {subscription.shippingAddress.city}
                                </p>
                              </div>
                              <button
                                onClick={() => navigate(`/subscriptions/${subscription._id}/edit`)}
                                className="p-2 hover:bg-gray-200 dark:hover:bg-dark-border rounded-lg transition"
                              >
                                <Edit size={16} />
                              </button>
                            </div>
                          </div>

                          {/* Actions */}
                          <div className="flex flex-wrap gap-3">
                            {subscription.status === 'active' && (
                              <>
                                <button
                                  onClick={() => handlePause(subscription._id)}
                                  className="flex items-center gap-2 px-4 py-2 border-2 border-yellow-600 text-yellow-600 rounded-lg font-semibold hover:bg-yellow-50 dark:hover:bg-yellow-900/20 transition"
                                >
                                  <Pause size={16} />
                                  Duraklat
                                </button>
                                <button
                                  onClick={() => handleCancel(subscription._id)}
                                  className="flex items-center gap-2 px-4 py-2 border-2 border-red-600 text-red-600 rounded-lg font-semibold hover:bg-red-50 dark:hover:bg-red-900/20 transition"
                                >
                                  <X size={16} />
                                  İptal Et
                                </button>
                              </>
                            )}

                            {subscription.status === 'paused' && (
                              <>
                                <button
                                  onClick={() => handleResume(subscription._id)}
                                  className="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg font-semibold hover:shadow-lg transition"
                                >
                                  <Play size={16} />
                                  Devam Ettir
                                </button>
                                <button
                                  onClick={() => handleCancel(subscription._id)}
                                  className="flex items-center gap-2 px-4 py-2 border-2 border-red-600 text-red-600 rounded-lg font-semibold hover:bg-red-50 dark:hover:bg-red-900/20 transition"
                                >
                                  <X size={16} />
                                  İptal Et
                                </button>
                              </>
                            )}

                            <button
                              onClick={() => navigate(`/subscriptions/${subscription._id}`)}
                              className="flex items-center gap-2 px-4 py-2 border-2 border-gray-300 dark:border-dark-border rounded-lg font-semibold hover:bg-gray-50 dark:hover:bg-dark-hover transition dark:text-dark-text"
                            >
                              Detaylar
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </motion.div>
                )
              })}
            </div>
          )}
        </div>
      </div>
    </>
  )
}

export default MySubscriptions